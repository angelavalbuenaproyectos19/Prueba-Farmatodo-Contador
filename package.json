{
  "name": "contador-frecuencia-palabras",
  "version": "1.0.0",
  "description": "Contador de frecuencia de palabras: lee un archivo de texto, cuenta palabras y caracteres e imprime el histograma ordenado",
  "license": "MIT",
  "private": true,
  "bin": {
    "contador-palabras": "src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/cli.js tests/fixtures/ejemplo.txt",
    "test": "node --test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  }
}
